{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["PORT", "MOCKS_PORT", "WEB_PORT", "MOCKS_URL", "NEXT_PUBLIC_MOCKS_URL"]
    },
    "lint": {"dependsOn": ["^lint"], "outputLogs": "errors-only"},
    "check-types": {"dependsOn": ["^check-types"], "outputLogs": "errors-only"},
    "test": {"dependsOn": ["^test"], "outputLogs": "new-only"},
    "clean": {"cache": false}
  }
}
